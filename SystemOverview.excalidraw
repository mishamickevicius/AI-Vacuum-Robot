    },
    {
      "id": "5lqrr5mmvI0VhkIqklyY9",
      "type": "text",
      "x": 1671.077555765576,
      "y": -489.37717704823046,
      "width": 532.6753976004466,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 571203328,
      "version": 345,
      "versionNonce": 1524380170,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788806466363,
      "link": null,
      "locked": false,
      "text": "Mapping Mode will be a user controlled\nmode that will allow the Vacuum Robot\nto make a map of the room in its system",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mapping Mode will be a user controlled mode that will allow the Vacuum Robot to make a map of the room in its system",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZKyJGKTe6WfJWibNop-Ew",
      "type": "text",
      "x": 1642.5061271941472,
      "y": -342.23431990537335,
      "width": 635.9038957868306,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1095646976,
      "version": 352,
      "versionNonce": 1402518614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788806457321,
      "link": null,
      "locked": false,
      "text": "Route Planning Mode will take place immediately\nafter Mapping Mode and will design a path to\nefficiently go through the entire room",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Route Planning Mode will take place immediately after Mapping Mode and will design a path to efficiently go through the entire room",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qzL2b9BIDCMTOk1mbgqBg",
      "type": "text",
      "x": 1658.220412908433,
      "y": -179.37717704823046,
      "width": 543.4987967354909,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 938799360,
      "version": 207,
      "versionNonce": 1878160458,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788806450058,
      "link": null,
      "locked": false,
      "text": "Cleaning Mode is when the Vacuum Robot\nwill follow the path to clean the room.\nThis part is fully autonomous. ",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cleaning Mode is when the Vacuum Robot will follow the path to clean the room. This part is fully autonomous. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
